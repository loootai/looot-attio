{
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": false,
  "jsxSingleQuote": false,
  "printWidth": 100,
  "semi": false,
  "singleQuote": false,
  "tabWidth": 4,
  "trailingComma": "es5",
  "overrides": [
    {
      "files": [".prettierrc", "*.json", "*.jsonc", "*.graphql", "*.md", "*.yml", "*.yaml"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
